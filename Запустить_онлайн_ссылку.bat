@echo off
chcp 65001 >nul
title ПрофЭксперт - Онлайн Ссылка (Cloudflare)
echo ========================================================
echo   ООО «ПрофЭксперт» - Быстрая демонстрация сайта
echo ========================================================
echo.
echo 1. Запуск веб-сервера...
start /b python server.py
timeout /t 2 >nul
echo.
